{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": ": ",
        "key": {
            "width": 0
        },
        "percent": {
            "type": 9,
            "green": 40,
            "yellow": 70
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#8}┌───────────────────{#3} Hardware {#8}────────────────────┐"
        },
        {
            "type": "cpu",
            "key": "󰻠 ",
            "keyColor": "light_yellow",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "󰍛 ",
            "keyColor": "light_yellow"
        },
        {
            "type": "memory",
            "key": "󰑭 ",
            "keyColor": "light_yellow"
        },
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "light_yellow",
            "folders": "/"
        },
        {
            "type": "disk",
            "key": "󰆓 ",
            "keyColor": "light_yellow",
            "folders": "/home"
        },
        {
            "type": "custom",
            "format": "{#8}└─────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "{#8}┌───────────────────{#3} Software {#8}────────────────────┐"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "{#8}└─────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "{#8}┌───────────────────{#4} DE / WM {#8}─────────────────────┐"
        },
        {
            "type": "de",
            "key": "󰧨 ",
            "keyColor": "light_blue"
        },
        {
            "type": "lm",
            "key": "󰍂 ",
            "keyColor": "light_blue"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "light_blue"
        },
        {
            "type": "wmtheme",
            "key": "󰉼 ",
            "keyColor": "light_blue"
        },
        {
            "type": "theme",
            "key": "󰉼 ",
            "keyColor": "light_blue"
        },
        {
            "type": "icons",
            "key": "󰀻 ",
            "keyColor": "light_blue"
        },
        {
            "type": "custom",
            "format": "{#8}└─────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "{#8}┌─────────────────{#5} Uptime / Age {#8}──────────────────┐"
        },
        {
            "type": "disk",
            "key": "󰔛 ",
            "keyColor": "light_magenta",
            "folders": "/",
            "format": "{days} days"
        },
        {
            "type": "uptime",
            "key": "󰅐 ",
            "keyColor": "light_magenta"
        },
        {
            "type": "custom",
            "format": "{#8}└─────────────────────────────────────────────────┘"
        }
    ]
}
