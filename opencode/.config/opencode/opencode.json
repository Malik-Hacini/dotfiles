{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": false,
  "plugin": ["@howaboua/opencode-usage-plugin"],
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },
  "lsp": {},
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": ["mise", "exec", "node@26.5.1", "--", "npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_KEY": "{file:~/.config/opencode/firecrawl_api_key}"
      }
    }
  },
  "permission": {
    "edits": "ask"
  }
}
