# ---------------------
# Synctex
# ---------------------
set synctex true
set synctex-editor-command "nvim --remote-silent +%{line} %{input}"

# ---------------------
# Basic Settings
# ---------------------
set highlight-transparency .1
set zoom-center "true"
set selection-clipboard clipboard
set render-loading true
set window-width 1280
set window-height 1080
set window-title-basename true
set adjust-open "best-fit"
set guioptions sv # Remove all GUI elements (menubar, statusbar, scrollbars)
set scroll-step 40 # Increase scroll speed

# ---------------------
# Keybindings
# ---------------------
map <Space> toggle_index
map p print
map w recolor
map k scroll smooth-up
map j scroll smooth-down
map <C-v> toggle_fullscreen

# Generated by Omarchy's theme-set hook from the active semantic palette.
include omarchy-theme

# ---------------------
# Recoloring (PDF content)
# ---------------------
set recolor                     false
set recolor-keephue             false    # Use the faster theme-color mapping

# Toggle recoloring with 'w' (mapped above) when needed.
