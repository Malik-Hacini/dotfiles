[Desktop Entry]
Type=Application
Name=Zathura
Comment=Open PDFs in Zathura, using workspace tabs when i3 supports them
Exec=/usr/bin/env zathura-tabbed %U
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;application/x-pdf;application/acrobat;application/vnd.pdf;text/pdf;text/x-pdf;
NoDisplay=false
