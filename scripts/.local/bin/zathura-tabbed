#!/usr/bin/env bash

set -euo pipefail

if [[ ${XDG_SESSION_TYPE:-} == wayland || ${XDG_CURRENT_DESKTOP:-} == *Hyprland* ]]; then
  exec zathura "$@"
fi

workspace_name() {
  i3-msg -t get_workspaces | jq -r '.[] | select(.focused == true).name' | head -n1
}

workspace_mark() {
  local ws safe
  ws="$(workspace_name)"
  [ -z "$ws" ] && ws="default"
  safe="$(printf '%s' "$ws" | tr -c '[:alnum:]_-' '_')"
  printf '__i3_pdf_tabs_%s' "$safe"
}

container_id() {
  local mark="$1"
  i3-msg -t get_tree | jq -r --arg mark "$mark" '
    ..
    | objects
    | select(.window == null)
    | select(.layout == "tabbed")
    | select((.marks // []) | index($mark))
    | .id
  ' | head -n1
}

create_pdf_container() {
  local mark="$1"
  local layout_file

  layout_file="$(mktemp)"
  cat >"$layout_file" <<EOF
{
  "type": "con",
  "layout": "tabbed",
  "marks": ["$mark"],
  "nodes": [
    { "swallows": [ { "class": "^Zathura$" } ] }
  ]
}
EOF

  i3-msg --quiet "append_layout $layout_file"
  rm -f "$layout_file"
}

ensure_pdf_container() {
  local mark="$1" id target_id

  id="$(container_id "$mark")"

  if [ -z "$id" ]; then
    i3-msg --quiet "[con_mark=\"$mark\"] unmark \"$mark\"" || true
    create_pdf_container "$mark"
    id="$(container_id "$mark")"
  fi

  if [ -z "$id" ]; then
    echo "Could not create/focus PDF tab container" >&2
    exit 1
  fi

  target_id="$(i3-msg -t get_tree | jq -r --argjson id "$id" '
    ..
    | objects
    | select(.id == $id)
    | (.focus[0] // (.nodes[0].id) // .id)
  ')"

  i3-msg --quiet "[con_id=\"$target_id\"] focus"
}

decode_target() {
  local raw="$1"
  if [[ "$raw" == file://* ]]; then
    python3 - "$raw" <<'PY'
import sys
from urllib.parse import unquote, urlparse

uri = sys.argv[1]
parsed = urlparse(uri)
print(unquote(parsed.path))
PY
  else
    printf '%s\n' "$raw"
  fi
}

basename_label() {
  local path="$1"
  basename -- "$path"
}

list_window_con_ids() {
  local container="$1"
  i3-msg -t get_tree | jq -r --argjson cid "$container" '
    (.. | objects | select(.id == $cid)) as $root
    | $root
    | ..
    | objects
    | select(.window != null)
    | select((.window_properties.class // "") == "Zathura")
    | .id
  '
}

set_title_format() {
  local con_id="$1"
  local label="$2"
  local escaped xid

  xid="$(i3-msg -t get_tree | jq -r --argjson id "$con_id" '
    ..
    | objects
    | select(.id == $id)
    | (.window // empty)
  ' | head -n1)"

  if [ -n "$xid" ]; then
    xprop -id "$xid" -f _NET_WM_NAME 8u -set _NET_WM_NAME "$label" >/dev/null 2>&1 || true
    xprop -id "$xid" -f WM_NAME 8s -set WM_NAME "$label" >/dev/null 2>&1 || true
  fi

  escaped="${label//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  i3-msg --quiet "[con_id=\"$con_id\"] title_format \"$escaped\"" >/dev/null || true
}

wait_and_set_basename() {
  local container="$1"
  local label="$2"
  shift 2
  local old_ids=("$@")
  local retries=40
  local found=""

  while [ "$retries" -gt 0 ]; do
    local current id seen
    mapfile -t current < <(list_window_con_ids "$container")

    for id in "${current[@]}"; do
      seen=0
      for old in "${old_ids[@]}"; do
        if [ "$id" = "$old" ]; then
          seen=1
          break
        fi
      done
      if [ "$seen" -eq 0 ] && [ -n "$id" ]; then
        found="$id"
        break
      fi
    done

    if [ -n "$found" ]; then
      set_title_format "$found" "$label"
      return 0
    fi

    retries=$((retries - 1))
    sleep 0.05
  done

  return 1
}

main() {
  local mark target label cid
  mark="$(workspace_mark)"

  if [ "$#" -eq 0 ]; then
    ensure_pdf_container "$mark"
    zathura >/dev/null 2>&1 &
    exit 0
  fi

  for target in "$@"; do
    ensure_pdf_container "$mark"
    cid="$(container_id "$mark")"
    target="$(decode_target "$target")"
    label="$(basename_label "$target")"

    mapfile -t old_ids < <(list_window_con_ids "$cid")
    zathura -- "$target" >/dev/null 2>&1 &
    wait_and_set_basename "$cid" "$label" "${old_ids[@]}" >/dev/null 2>&1 || true
    sleep 0.06
  done
}

main "$@"
