[filechooser]
cmd=$HOME/.config/xdg-desktop-portal-termfilechooser/yazi-wrapper.sh
default_dir=$HOME
; Uncomment to skip creating destination save files with instructions in them
; create_help_file=0
; Override the terminal emulator command if needed.
env=TERMCMD=xdg-terminal-exec

; Mode must be one of 'suggested', 'default', or 'last'.
open_mode=suggested
save_mode=suggested
