{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "providers": {
    "openai": {
      "settings": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },
  "lsp": {},
  "mcp": {
    "servers": {
      "firecrawl": {
        "type": "local",
        "command": ["mise", "exec", "node@26.5.1", "--", "npx", "-y", "firecrawl-mcp"],
        "disabled": false,
        "environment": {
          "FIRECRAWL_API_KEY": "{file:~/.config/opencode/firecrawl_api_key}"
        }
      }
    }
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" }
  ]
}
