#!/usr/bin/env sh
set -eu

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
wal_cache_dir="$cache_home/wal"
wallpaper_state="$state_home/theme-switch/current-wallpaper"
template_source_dir="$config_home/theme-switch/templates"
wal_template_dir="$config_home/wal/templates"
default_wallpaper="$HOME/Pictures/Wallpapers/catppuccin_gyro.jpg"
fehbg="$HOME/.fehbg"

usage() {
    printf 'Usage: %s [--restore] [--no-reload] [--theme NAME | --wallpaper PATH] [--set-wallpaper PATH]\n' "${0##*/}" >&2
}

warn() {
    printf '%s\n' "$*" >&2
}

normalize_theme() {
    case "$1" in
        latte|frappe|macchiato|mocha)
            printf 'catppuccin-%s\n' "$1"
            ;;
        *)
            printf '%s\n' "$1"
            ;;
    esac
}

write_wallpaper_state() {
    mkdir -p "$(dirname "$wallpaper_state")"
    printf '%s\n' "$1" > "$wallpaper_state"
}

sync_templates() {
    [ -d "$template_source_dir" ] || return 0

    mkdir -p "$wal_template_dir"

    for template in "$template_source_dir"/*; do
        [ -f "$template" ] || continue
        install -m 0644 "$template" "$wal_template_dir/$(basename "$template")"
    done
}

link_generated_file() {
    source_file=$1
    target_file=$2

    [ -e "$source_file" ] || return 0

    mkdir -p "$(dirname "$target_file")"
    rm -f "$target_file"
    ln -s "$source_file" "$target_file"
}

sync_generated_targets() {
    local_yazi_flavor_dir="$config_home/yazi/flavors/pywal.yazi"

    link_generated_file "$wal_cache_dir/lazygit-theme.yml" "$config_home/lazygit/theme.yml"
    link_generated_file "$wal_cache_dir/pywal.theme" "$config_home/btop/themes/pywal.theme"

    mkdir -p "$local_yazi_flavor_dir"
    link_generated_file "$wal_cache_dir/yazi-flavor.toml" "$local_yazi_flavor_dir/flavor.toml"
    link_generated_file "$config_home/yazi/flavors/catppuccin-mocha.yazi/tmtheme.xml" "$local_yazi_flavor_dir/tmtheme.xml"
}

current_wallpaper() {
    if [ -f "$wallpaper_state" ]; then
        cat "$wallpaper_state"
        return 0
    fi

    if [ -f "$wal_cache_dir/wal" ]; then
        cat "$wal_cache_dir/wal"
        return 0
    fi

    if [ -f "$default_wallpaper" ]; then
        printf '%s\n' "$default_wallpaper"
        return 0
    fi

    return 1
}

write_fehbg() {
    wallpaper=$1

    [ -n "$wallpaper" ] || return 0

    mkdir -p "$(dirname "$fehbg")"
    printf '#!/usr/bin/env sh\nfeh --no-fehbg --bg-fill "%s"\n' "$wallpaper" > "$fehbg"
    chmod +x "$fehbg"
}

apply_fehbg() {
    if [ -n "${DISPLAY:-}" ] && [ -x "$fehbg" ] && command -v feh >/dev/null 2>&1; then
        "$fehbg" >/dev/null 2>&1 || true
    fi
}

merge_xresources() {
    if command -v xrdb >/dev/null 2>&1 && [ -f "$wal_cache_dir/colors.Xresources" ]; then
        xrdb -merge "$wal_cache_dir/colors.Xresources" >/dev/null 2>&1 || true
    fi
}

post_apply() {
    merge_xresources
    sync_generated_targets

    if wallpaper=$(current_wallpaper 2>/dev/null); then
        if [ -f "$wallpaper" ]; then
            write_fehbg "$wallpaper"
            apply_fehbg
        fi
    fi
}

reload_i3() {
    if [ -n "${I3SOCK:-}" ] && command -v i3-msg >/dev/null 2>&1; then
        i3-msg reload >/dev/null 2>&1 || true
    fi
}

run_wal() {
    if ! command -v wal >/dev/null 2>&1; then
        warn "wal (pywal16) is not installed."
        return 1
    fi

    sync_templates
    wal "$@"
    post_apply
}

restore_theme() {
    if command -v wal >/dev/null 2>&1; then
        if [ -f "$wal_cache_dir/colors.json" ] || [ -f "$wal_cache_dir/sequences" ] || [ -f "$wal_cache_dir/colors.Xresources" ]; then
            sync_templates
            wal -R -n -e >/dev/null 2>&1 || true
            post_apply
            return 0
        fi

        if [ -f "$default_wallpaper" ]; then
            write_wallpaper_state "$default_wallpaper"
            sync_templates
            wal --theme catppuccin-mocha --cols16 -n -e >/dev/null 2>&1 || true
            post_apply
            return 0
        fi
    fi

    if wallpaper=$(current_wallpaper 2>/dev/null); then
        if [ -f "$wallpaper" ]; then
            write_fehbg "$wallpaper"
            apply_fehbg
        fi
    fi
}

restore=false
reload_after_apply=true
theme_name=
theme_wallpaper=
image_wallpaper=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --restore)
            restore=true
            ;;
        --no-reload)
            reload_after_apply=false
            ;;
        --theme)
            [ "$#" -ge 2 ] || {
                usage
                exit 1
            }
            theme_name=$2
            shift
            ;;
        --wallpaper)
            [ "$#" -ge 2 ] || {
                usage
                exit 1
            }
            image_wallpaper=$2
            shift
            ;;
        --set-wallpaper)
            [ "$#" -ge 2 ] || {
                usage
                exit 1
            }
            theme_wallpaper=$2
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
    shift
done

if [ "$restore" = true ]; then
    if [ -n "$theme_name" ] || [ -n "$image_wallpaper" ] || [ -n "$theme_wallpaper" ] || [ "$reload_after_apply" = false ]; then
        usage
        exit 1
    fi

    restore_theme
    exit 0
fi

if [ -n "$theme_name" ] && [ -n "$image_wallpaper" ]; then
    usage
    exit 1
fi

if [ -n "$image_wallpaper" ]; then
    if [ ! -f "$image_wallpaper" ]; then
        warn "Wallpaper not found: $image_wallpaper"
        exit 1
    fi

    write_wallpaper_state "$image_wallpaper"
    run_wal -i "$image_wallpaper" --cols16 -n -e
    [ "$reload_after_apply" = true ] && reload_i3
    exit 0
fi

if [ -n "$theme_name" ]; then
    if [ -n "$theme_wallpaper" ]; then
        if [ ! -f "$theme_wallpaper" ]; then
            warn "Wallpaper not found: $theme_wallpaper"
            exit 1
        fi

        write_wallpaper_state "$theme_wallpaper"
    fi

    theme_name=$(normalize_theme "$theme_name")
    run_wal --theme "$theme_name" --cols16 -n -e
    [ "$reload_after_apply" = true ] && reload_i3
    exit 0
fi

usage
exit 1
