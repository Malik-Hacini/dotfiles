#!/usr/bin/env bash

set -u

show_help() {
    cat <<'EOF'
Usage: update-managed-packages [OPTIONS]

Update distro packages plus the non-package-manager tools installed by this
dotfiles repo.

Options:
  --system-only, --apt-only      Only update distro-managed packages
  --non-system-only, --non-apt-only
                                 Only update non-package-manager tools
  --with-fonts                   Refresh repo-managed fonts
  -h, --help                     Show this help text

Environment:
  JULIA_UPDATE_TIMEOUT           Time before skipping a stuck juliaup command (default: 5m)
EOF
}

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            show_help
            exit 0
            ;;
    esac
done

SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
SCRIPT_REPO_DIR=$(cd "$(dirname "$SCRIPT_PATH")/../../.." && pwd)

source "$SCRIPT_REPO_DIR/install/bootstrap.sh"
source "$SCRIPT_REPO_DIR/install/ppas.sh"
source "$SCRIPT_REPO_DIR/install/tools.sh"

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.juliaup/bin:$HOME/.opencode/bin:$PATH"

UPDATE_SYSTEM=true
UPDATE_NON_SYSTEM=true
UPDATE_FONTS=false
INSTALL_PACKAGES=true

NVIM_INSTALL_DIR="$HOME/.local/opt/nvim"
GH_INSTALL_DIR="$HOME/.local/opt/gh"
SEVENZIP_INSTALL_DIR="$HOME/.local/opt/7zip"
CLIPBOARD_INSTALL_DIR="$HOME/.local/opt/clipboard"
SESH_INSTALL_DIR="$HOME/.local/opt/sesh"
KITTY_INSTALL_DIR="$HOME/.local/kitty.app"
LOCALSEND_INSTALL_DIR="$HOME/.local/opt/localsend"
JULIAUP_INSTALL_DIR="$HOME/.juliaup"
JULIA_UPDATE_TIMEOUT=${JULIA_UPDATE_TIMEOUT:-5m}
TPM_INSTALL_DIR="$HOME/.tmux/plugins/tpm"
FONT_ROOT="/usr/local/share/fonts"
FONT_DIR="$FONT_ROOT/nerd-fonts"
FONT_AWESOME_DIR="$FONT_ROOT/fontawesome"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --system-only|--apt-only)
            UPDATE_NON_SYSTEM=false
            ;;
        --non-system-only|--non-apt-only)
            UPDATE_SYSTEM=false
            ;;
        --with-fonts)
            UPDATE_FONTS=true
            ;;
        *)
            die "Unknown option: $1"
            ;;
    esac
    shift
done

INSTALL_PACKAGES=$UPDATE_SYSTEM

resolve_cmd_path() {
    local cmd=$1
    local path

    path=$(command -v "$cmd" 2>/dev/null || true)
    [ -n "$path" ] || return 1

    readlink -f "$path" 2>/dev/null || printf '%s\n' "$path"
}

path_matches_prefix() {
    local path=$1
    local prefix=$2

    case "$path" in
        "$prefix"|"$prefix"/*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

cmd_is_managed() {
    local cmd=$1
    shift
    local path
    local prefix

    path=$(resolve_cmd_path "$cmd") || return 1

    for prefix in "$@"; do
        path_matches_prefix "$path" "$prefix" && return 0
    done

    return 1
}

cmd_matches_prefixes() {
    local cmd=$1
    shift
    local raw_path resolved_path prefix

    raw_path=$(command -v "$cmd" 2>/dev/null || true)
    [ -n "$raw_path" ] || return 1

    resolved_path=$(resolve_cmd_path "$cmd") || return 1

    for prefix in "$@"; do
        path_matches_prefix "$raw_path" "$prefix" && return 0
        path_matches_prefix "$resolved_path" "$prefix" && return 0
    done

    return 1
}

system_package_is_installed() {
    local package=$1
    local status

    case "$DISTRO_FAMILY" in
        debian)
            status=$(dpkg-query -W -f='${db:Status-Status}\n' "$package" 2>/dev/null || true)
            [ "$status" = installed ]
            ;;
        arch)
            pacman -Q "$package" >/dev/null 2>&1
            ;;
        *)
            return 1
            ;;
    esac
}

any_system_package_installed() {
    local package

    for package in "$@"; do
        [ -n "$package" ] || continue
        system_package_is_installed "$package" && return 0
    done

    return 1
}

install_file_with_optional_sudo() {
    local source_path=$1
    local destination_path=$2
    local mode=${3:-0755}

    if install -m "$mode" "$source_path" "$destination_path" >/dev/null 2>&1; then
        return 0
    fi

    sudo install -m "$mode" "$source_path" "$destination_path"
}

find_managed_zen_binary() {
    local candidate

    for candidate in \
        "$HOME/.local/opt/zen/zen" \
        "$HOME/.tarball-installations/zen/zen"
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

download_file() {
    local url=$1
    local destination=$2

    curl -fsSL "$url" -o "$destination"
}

install_from_tarball() {
    local url=$1
    local tar_flag=$2
    local extracted_dir_name=$3
    local install_dir=$4
    local binary_relative_path=$5
    local link_path=$6
    local tmp_dir archive extracted_dir

    tmp_dir=$(mktemp -d)
    archive="$tmp_dir/archive"
    extracted_dir="$tmp_dir/$extracted_dir_name"

    if ! download_file "$url" "$archive"; then
        error "Failed to download archive: $url"
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! tar "$tar_flag" "$archive" -C "$tmp_dir"; then
        error "Failed to extract archive: $url"
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! mkdir -p "$HOME/.local/opt" "$HOME/.local/bin"; then
        error "Failed to prepare local install directories."
        rm -rf "$tmp_dir"
        return 1
    fi

    if [ ! -x "$extracted_dir/$binary_relative_path" ]; then
        error "Extracted archive did not contain expected binary: $binary_relative_path"
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! "$extracted_dir/$binary_relative_path" --version >/dev/null 2>&1; then
        error "Extracted binary failed smoke test: $binary_relative_path"
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! replace_path "$extracted_dir" "$install_dir"; then
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! ln -sfn "$install_dir/$binary_relative_path" "$link_path"; then
        error "Failed to link $link_path."
        rm -rf "$tmp_dir" "$install_dir"
        return 1
    fi

    rm -rf "$tmp_dir"
    return 0
}

update_system_packages() {
    ensure_supported_distro

    case "$DISTRO_FAMILY" in
        debian)
            info "Refreshing apt package metadata..."
            sudo apt-get update || return 1

            info "Upgrading installed apt packages..."
            sudo apt-get upgrade -y --with-new-pkgs || return 1
            ;;
        arch)
            if command -v omarchy >/dev/null 2>&1; then
                info "Updating Omarchy, system packages, and AUR packages through Omarchy..."
                omarchy update -y || return 1
                return 0
            fi

            AUR_HELPER_CMD="$(current_aur_helper 2>/dev/null || true)"
            if [ -n "$AUR_HELPER_CMD" ]; then
                info "Synchronizing pacman and AUR packages with $AUR_HELPER_CMD..."
                case "$AUR_HELPER_CMD" in
                    yay)
                        "$AUR_HELPER_CMD" -Syu --noconfirm --answerdiff None --answerclean None || return 1
                        ;;
                    *)
                        "$AUR_HELPER_CMD" -Syu --noconfirm || return 1
                        ;;
                esac
            else
                info "Synchronizing pacman packages and upgrading the system..."
                sudo pacman -Syu --noconfirm || return 1
            fi
            ;;
    esac
}

update_tpm() {
    if [ ! -d "$TPM_INSTALL_DIR/.git" ]; then
        info "Skipping TPM: $TPM_INSTALL_DIR is not a git clone."
        return 0
    fi

    info "Updating tmux plugin manager (TPM)..."
    git -C "$TPM_INSTALL_DIR" pull --ff-only || return 1
    log "TPM updated."
}

update_rust_toolchain() {
    if ! cmd_is_managed rustup "$HOME/.cargo" "$HOME/.local/bin/rustup"; then
        info "Skipping Rust toolchain: rustup is not managed by this repo."
        return 0
    fi

    info "Updating rustup and the stable Rust toolchain..."

    rustup self update || return 1
    rustup update stable || return 1
    rustup default stable >/dev/null 2>&1 || return 1

    link_cargo_binary rustup || return 1
    link_cargo_binary cargo || return 1
    link_cargo_binary rustc || return 1

    log "Rust toolchain updated."
}

update_tree_sitter_cli() {
    if ! cmd_is_managed tree-sitter "$HOME/.cargo" "$HOME/.local/bin/tree-sitter"; then
        info "Skipping tree-sitter CLI: binary is not managed by this repo."
        return 0
    fi

    if ! command -v cargo >/dev/null 2>&1; then
        error "cargo is required to update tree-sitter CLI."
        return 1
    fi

    if ! ensure_tree_sitter_build_deps; then
        return 1
    fi

    info "Updating tree-sitter CLI via cargo..."
    cargo install --locked --force tree-sitter-cli || return 1
    link_cargo_binary tree-sitter || return 1
    tree-sitter --version >/dev/null 2>&1 || return 1
    log "tree-sitter CLI updated."
}

update_neovim_managed() {
    if [ ! -x "$NVIM_INSTALL_DIR/bin/nvim" ] && ! cmd_is_managed nvim "$NVIM_INSTALL_DIR"; then
        info "Skipping Neovim: $NVIM_INSTALL_DIR is not installed."
        return 0
    fi

    install_neovim
}

update_fzf() {
    if any_system_package_installed fzf; then
        info "Skipping fzf: system package manager handles it."
        return 0
    fi

    if [ ! -d "$HOME/.fzf/.git" ]; then
        info "Skipping fzf: ~/.fzf is not a managed git clone."
        return 0
    fi

    info "Updating fzf..."
    git -C "$HOME/.fzf" pull --ff-only || return 1
    "$HOME/.fzf/install" --bin || return 1
    log "fzf updated."
}

update_7zip_managed() {
    local version version_digits arch asset url tmp_dir extract_dir

    if [ "$DISTRO_FAMILY" = arch ] && any_system_package_installed 7zip; then
        info "Skipping 7-Zip: system package manager handles it."
        return 0
    fi

    if [ ! -x "$SEVENZIP_INSTALL_DIR/7zz" ] && ! cmd_is_managed 7zz "$SEVENZIP_INSTALL_DIR"; then
        info "Skipping 7-Zip: $SEVENZIP_INSTALL_DIR is not installed."
        return 0
    fi

    version=$(github_latest_release_tag ip7z/7zip)
    [ -n "$version" ] || {
        error "Could not determine the latest 7-Zip version."
        return 1
    }

    version_digits=${version//./}
    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            asset="7z${version_digits}-linux-x64.tar.xz"
            ;;
        aarch64|arm64)
            asset="7z${version_digits}-linux-arm64.tar.xz"
            ;;
        armv7l|armv6l|arm)
            asset="7z${version_digits}-linux-arm.tar.xz"
            ;;
        i686|i386)
            asset="7z${version_digits}-linux-x86.tar.xz"
            ;;
        *)
            error "Unsupported architecture for 7-Zip archive: $arch"
            return 1
            ;;
    esac

    url="https://github.com/ip7z/7zip/releases/download/${version}/${asset}"
    tmp_dir=$(mktemp -d)
    extract_dir="$tmp_dir/extracted"

    if ! download_file "$url" "$tmp_dir/7zip.tar.xz"; then
        error "Failed to download 7-Zip archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    mkdir -p "$extract_dir" || {
        rm -rf "$tmp_dir"
        return 1
    }

    if ! tar -xJf "$tmp_dir/7zip.tar.xz" -C "$extract_dir"; then
        error "Failed to extract 7-Zip archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if [ ! -x "$extract_dir/7zz" ]; then
        error "7-Zip archive did not contain the expected 7zz binary."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! replace_path "$extract_dir" "$SEVENZIP_INSTALL_DIR"; then
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! ln -sfn "$SEVENZIP_INSTALL_DIR/7zz" "$HOME/.local/bin/7zz"; then
        error "Failed to link 7zz into ~/.local/bin."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! ln -sfn "$SEVENZIP_INSTALL_DIR/7zz" "$HOME/.local/bin/7z"; then
        error "Failed to link 7z into ~/.local/bin."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! "$HOME/.local/bin/7zz" --help >/dev/null 2>&1; then
        error "7-Zip failed smoke test after update."
        rm -rf "$tmp_dir"
        return 1
    fi

    rm -rf "$tmp_dir"
    log "7-Zip updated to ${version}."
}

update_starship() {
    if any_system_package_installed starship; then
        info "Skipping Starship: system package manager handles it."
        return 0
    fi

    if ! cmd_is_managed starship /usr/local/bin/starship "$HOME/.local/bin/starship"; then
        info "Skipping Starship: binary is not managed by the upstream installer."
        return 0
    fi

    info "Updating Starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y || return 1
    starship --version >/dev/null 2>&1 || return 1
    log "Starship updated."
}

update_zoxide() {
    if any_system_package_installed zoxide; then
        info "Skipping Zoxide: system package manager handles it."
        return 0
    fi

    if ! cmd_is_managed zoxide "$HOME/.local/bin/zoxide" /usr/local/bin/zoxide; then
        info "Skipping Zoxide: binary is not managed by the upstream installer."
        return 0
    fi

    info "Updating Zoxide..."
    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh || return 1
    zoxide --version >/dev/null 2>&1 || return 1
    log "Zoxide updated."
}

update_yazi() {
    local version arch asset url tmp_dir matches extracted_dir yazi_path ya_path

    if any_system_package_installed yazi; then
        info "Skipping Yazi: system package manager handles it."
        return 0
    fi

    if ! command -v yazi >/dev/null 2>&1; then
        info "Skipping Yazi: binary is not installed."
        return 0
    fi

    if ! cmd_matches_prefixes yazi /usr/local/bin "$HOME/.local"; then
        info "Skipping Yazi: executable is not in a supported user-managed location."
        return 0
    fi

    version=$(github_latest_release_tag sxyazi/yazi)
    [ -n "$version" ] || {
        error "Could not determine the latest Yazi version."
        return 1
    }

    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            asset="yazi-x86_64-unknown-linux-musl.zip"
            ;;
        aarch64|arm64)
            asset="yazi-aarch64-unknown-linux-musl.zip"
            ;;
        *)
            error "Unsupported architecture for Yazi prebuilt archive: $arch"
            return 1
            ;;
    esac

    url="https://github.com/sxyazi/yazi/releases/download/${version}/${asset}"
    tmp_dir=$(mktemp -d)
    yazi_path=$(resolve_cmd_path yazi) || {
        rm -rf "$tmp_dir"
        return 1
    }

    ya_path="$(dirname "$yazi_path")/ya"

    if ! download_file "$url" "$tmp_dir/yazi.zip"; then
        error "Failed to download Yazi archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! unzip -q "$tmp_dir/yazi.zip" -d "$tmp_dir"; then
        error "Failed to extract Yazi archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    matches=("$tmp_dir"/yazi-*)
    extracted_dir=${matches[0]}
    if [ ! -d "$extracted_dir" ]; then
        error "Yazi archive did not contain the expected directory."
        rm -rf "$tmp_dir"
        return 1
    fi

    info "Updating Yazi to ${version}..."
    install_file_with_optional_sudo "$extracted_dir/yazi" "$yazi_path" 0755 || {
        rm -rf "$tmp_dir"
        return 1
    }
    install_file_with_optional_sudo "$extracted_dir/ya" "$ya_path" 0755 || {
        rm -rf "$tmp_dir"
        return 1
    }

    rm -rf "$tmp_dir"
    yazi --version >/dev/null 2>&1 || return 1
    log "Yazi updated to ${version}."
}

update_lazygit() {
    local version arch asset url tmp_dir

    if any_system_package_installed lazygit; then
        info "Skipping Lazygit: system package manager handles it."
        return 0
    fi

    if ! cmd_is_managed lazygit /usr/local/bin/lazygit; then
        info "Skipping Lazygit: /usr/local/bin/lazygit is not managed by this repo."
        return 0
    fi

    version=$(github_latest_release_tag jesseduffield/lazygit)
    version=${version#v}
    [ -n "$version" ] || {
        error "Could not determine the latest Lazygit version."
        return 1
    }

    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            asset="lazygit_${version}_linux_x86_64.tar.gz"
            ;;
        aarch64|arm64)
            asset="lazygit_${version}_linux_arm64.tar.gz"
            ;;
        *)
            error "Unsupported architecture for Lazygit archive: $arch"
            return 1
            ;;
    esac

    url="https://github.com/jesseduffield/lazygit/releases/download/v${version}/${asset}"
    tmp_dir=$(mktemp -d)

    if ! download_file "$url" "$tmp_dir/lazygit.tar.gz"; then
        error "Failed to download Lazygit archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! tar -xzf "$tmp_dir/lazygit.tar.gz" -C "$tmp_dir"; then
        error "Failed to extract Lazygit archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    info "Updating Lazygit to v${version}..."
    sudo install -m 0755 "$tmp_dir/lazygit" /usr/local/bin/lazygit || {
        rm -rf "$tmp_dir"
        return 1
    }

    rm -rf "$tmp_dir"
    lazygit --version >/dev/null 2>&1 || return 1
    log "Lazygit updated to v${version}."
}

update_gh_managed() {
    local version version_no_v arch asset_arch asset url extracted_dir_name

    if any_system_package_installed github-cli gh; then
        info "Skipping GitHub CLI: system package manager handles it."
        return 0
    fi

    if [ ! -x "$GH_INSTALL_DIR/bin/gh" ] && ! cmd_is_managed gh "$GH_INSTALL_DIR"; then
        info "Skipping GitHub CLI: $GH_INSTALL_DIR is not installed."
        return 0
    fi

    version=$(github_latest_release_tag cli/cli)
    [ -n "$version" ] || {
        error "Could not determine the latest GitHub CLI version."
        return 1
    }

    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            asset_arch="amd64"
            ;;
        aarch64|arm64)
            asset_arch="arm64"
            ;;
        *)
            error "Unsupported architecture for GitHub CLI archive: $arch"
            return 1
            ;;
    esac

    version_no_v=${version#v}
    asset="gh_${version_no_v}_linux_${asset_arch}.tar.gz"
    extracted_dir_name="gh_${version_no_v}_linux_${asset_arch}"
    url="https://github.com/cli/cli/releases/download/${version}/${asset}"

    info "Updating GitHub CLI to ${version}..."
    install_from_tarball \
        "$url" \
        -xzf \
        "$extracted_dir_name" \
        "$GH_INSTALL_DIR" \
        "bin/gh" \
        "$HOME/.local/bin/gh" || return 1

    log "GitHub CLI updated to ${version}."
}

update_typst_managed() {
    if any_system_package_installed typst; then
        info "Skipping Typst: system package manager handles it."
        return 0
    fi

    if ! command -v typst >/dev/null 2>&1; then
        info "Skipping Typst: binary is not installed."
        return 0
    fi

    if ! cmd_matches_prefixes typst "$HOME"; then
        info "Skipping Typst: executable is not in a supported user-managed location."
        return 0
    fi

    info "Updating Typst with the built-in updater..."
    typst update || return 1
    typst --version >/dev/null 2>&1 || return 1
    log "Typst updated."
}

update_julia_managed() {
    local juliaup_bin="$JULIAUP_INSTALL_DIR/bin/juliaup"
    local julia_bin="$JULIAUP_INSTALL_DIR/bin/julia"
    local status

    if any_system_package_installed juliaup julia; then
        info "Skipping Julia: system package manager handles it."
        return 0
    fi

    if [ ! -x "$juliaup_bin" ] && ! cmd_is_managed juliaup "$JULIAUP_INSTALL_DIR"; then
        info "Skipping Julia: $JULIAUP_INSTALL_DIR is not installed."
        return 0
    fi

    if [ ! -x "$juliaup_bin" ]; then
        juliaup_bin=$(resolve_cmd_path juliaup) || return 1
    fi

    info "Updating Julia and juliaup..."
    run_juliaup_with_timeout "$juliaup_bin" self update
    status=$?
    case "$status" in
        0)
            ;;
        124|137)
            warn "Skipping Julia: juliaup self update timed out after $JULIA_UPDATE_TIMEOUT."
            return 0
            ;;
        *)
            return 1
            ;;
    esac

    run_juliaup_with_timeout "$juliaup_bin" update
    status=$?
    case "$status" in
        0)
            ;;
        124|137)
            warn "Skipping Julia: juliaup update timed out after $JULIA_UPDATE_TIMEOUT."
            return 0
            ;;
        *)
            return 1
            ;;
    esac

    if [ -x "$julia_bin" ]; then
        "$julia_bin" --version >/dev/null 2>&1 || return 1
    elif command -v julia >/dev/null 2>&1; then
        julia --version >/dev/null 2>&1 || return 1
    else
        error "Julia updated but the julia launcher is not available on PATH."
        return 1
    fi

    log "Julia updated."
}

run_juliaup_with_timeout() {
    if command -v timeout >/dev/null 2>&1; then
        timeout --kill-after=30s "$JULIA_UPDATE_TIMEOUT" "$@"
        return $?
    fi

    warn "timeout is not available; Julia update cannot be auto-skipped if it hangs."
    "$@"
}

update_clipboard_managed() {
    local version arch asset url tmp_dir

    if any_system_package_installed clipboard; then
        info "Skipping Clipboard: system package manager handles it."
        return 0
    fi

    if [ ! -x "$CLIPBOARD_INSTALL_DIR/bin/cb" ] && ! cmd_is_managed cb "$CLIPBOARD_INSTALL_DIR"; then
        info "Skipping Clipboard: $CLIPBOARD_INSTALL_DIR is not installed."
        return 0
    fi

    version=$(github_latest_release_tag Slackadays/Clipboard)
    [ -n "$version" ] || {
        error "Could not determine the latest Clipboard version."
        return 1
    }

    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            asset="clipboard-linux-amd64.zip"
            ;;
        aarch64|arm64)
            asset="clipboard-linux-arm64.zip"
            ;;
        *)
            error "Unsupported architecture for Clipboard archive: $arch"
            return 1
            ;;
    esac

    url="https://github.com/Slackadays/Clipboard/releases/download/${version}/${asset}"
    tmp_dir=$(mktemp -d)

    if ! download_file "$url" "$tmp_dir/clipboard.zip"; then
        error "Failed to download Clipboard archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    mkdir -p "$tmp_dir/clipboard" || {
        rm -rf "$tmp_dir"
        return 1
    }

    if ! unzip -q "$tmp_dir/clipboard.zip" -d "$tmp_dir/clipboard"; then
        error "Failed to extract Clipboard archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! mkdir -p "$HOME/.local/opt" "$HOME/.local/bin"; then
        error "Failed to prepare local install directories."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! replace_path "$tmp_dir/clipboard" "$CLIPBOARD_INSTALL_DIR"; then
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! ln -sfn "$CLIPBOARD_INSTALL_DIR/bin/cb" "$HOME/.local/bin/cb"; then
        error "Failed to link Clipboard into ~/.local/bin."
        rm -rf "$tmp_dir" "$CLIPBOARD_INSTALL_DIR"
        return 1
    fi

    if ! "$HOME/.local/bin/cb" --help >/dev/null 2>&1; then
        error "Clipboard failed smoke test after update."
        rm -rf "$tmp_dir" "$CLIPBOARD_INSTALL_DIR"
        rm -f "$HOME/.local/bin/cb"
        return 1
    fi

    rm -rf "$tmp_dir"
    log "Clipboard updated to ${version}."
}

update_sesh_binary() {
    local version arch asset url tmp_dir

    if [ ! -x "$SESH_INSTALL_DIR/sesh" ] && ! cmd_is_managed sesh "$SESH_INSTALL_DIR"; then
        info "Skipping sesh: $SESH_INSTALL_DIR is not installed."
        return 0
    fi

    version=$(github_latest_release_tag joshmedeski/sesh)
    [ -n "$version" ] || {
        error "Could not determine the latest sesh version."
        return 1
    }

    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            asset="sesh_Linux_x86_64.tar.gz"
            ;;
        aarch64|arm64)
            asset="sesh_Linux_arm64.tar.gz"
            ;;
        *)
            error "Unsupported architecture for sesh archive: $arch"
            return 1
            ;;
    esac

    url="https://github.com/joshmedeski/sesh/releases/download/${version}/${asset}"
    tmp_dir=$(mktemp -d)

    if ! download_file "$url" "$tmp_dir/sesh.tar.gz"; then
        error "Failed to download sesh archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! tar -xzf "$tmp_dir/sesh.tar.gz" -C "$tmp_dir"; then
        error "Failed to extract sesh archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if [ ! -x "$tmp_dir/sesh" ]; then
        error "sesh archive did not contain the expected binary."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! mkdir -p "$HOME/.local/opt" "$HOME/.local/bin" "$SESH_INSTALL_DIR"; then
        error "Failed to prepare sesh install directories."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! install -m 0755 "$tmp_dir/sesh" "$SESH_INSTALL_DIR/sesh"; then
        error "Failed to install sesh binary."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! ln -sfn "$SESH_INSTALL_DIR/sesh" "$HOME/.local/bin/sesh"; then
        error "Failed to link sesh into ~/.local/bin."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! "$HOME/.local/bin/sesh" --version >/dev/null 2>&1; then
        error "sesh failed smoke test after update."
        rm -rf "$tmp_dir"
        return 1
    fi

    rm -rf "$tmp_dir"
    log "sesh updated to ${version}."
}

update_sesh_managed() {
    if any_system_package_installed sesh-bin sesh; then
        info "Skipping sesh: system package manager handles it."
        return 0
    fi

    update_sesh_binary
}

update_python_tools_managed() {
    local tool
    local tools=(ipython jupytext black isort pylint)

    if ! command -v pipx >/dev/null 2>&1; then
        info "Skipping pipx tools: pipx is not installed."
        return 0
    fi

    info "Updating repo-managed pipx tools..."

    for tool in "${tools[@]}"; do
        if ! pipx list | grep -Eq "^[[:space:]]*package ${tool} "; then
            info "Skipping pipx tool not currently installed: $tool"
            continue
        fi

        pipx upgrade "$tool" || return 1
    done

    log "Repo-managed pipx tools updated."
}

update_kitty_managed() {
    if any_system_package_installed kitty; then
        info "Skipping Kitty: system package manager handles it."
        return 0
    fi

    if [ ! -x "$KITTY_INSTALL_DIR/bin/kitty" ] && ! cmd_is_managed kitty "$KITTY_INSTALL_DIR"; then
        info "Skipping Kitty: $KITTY_INSTALL_DIR is not installed."
        return 0
    fi

    info "Updating Kitty from the official upstream installer..."
    curl -fsSL https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin launch=n || return 1
    install_kitty || return 1
    log "Kitty updated."
}

update_localsend_managed() {
    if any_system_package_installed localsend; then
        info "Skipping LocalSend: system package manager handles it."
        return 0
    fi

    if [ ! -x "$LOCALSEND_INSTALL_DIR/localsend_app" ] && ! cmd_is_managed localsend "$LOCALSEND_INSTALL_DIR" "$HOME/.local/bin/localsend"; then
        info "Skipping LocalSend: $LOCALSEND_INSTALL_DIR is not installed."
        return 0
    fi

    install_localsend
}

update_zen_managed() {
    local zen_binary install_dir parent_dir arch asset url tmp_dir

    if any_system_package_installed zen-browser-bin zen-browser; then
        info "Skipping Zen Browser: system package manager handles it."
        return 0
    fi

    zen_binary=$(find_managed_zen_binary) || {
        info "Skipping Zen Browser: managed tarball install is not present."
        return 0
    }

    install_dir=$(dirname "$zen_binary")
    parent_dir=$(dirname "$install_dir")

    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            asset="zen.linux-x86_64.tar.xz"
            ;;
        aarch64|arm64)
            asset="zen.linux-aarch64.tar.xz"
            ;;
        *)
            error "Unsupported architecture for Zen Browser archive: $arch"
            return 1
            ;;
    esac

    url="https://github.com/zen-browser/desktop/releases/latest/download/${asset}"
    tmp_dir=$(mktemp -d)

    if ! download_file "$url" "$tmp_dir/zen.tar.xz"; then
        error "Failed to download Zen Browser archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! tar -xJf "$tmp_dir/zen.tar.xz" -C "$tmp_dir"; then
        error "Failed to extract Zen Browser archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if [ ! -x "$tmp_dir/zen/zen" ]; then
        error "Zen Browser archive did not contain the expected launcher."
        rm -rf "$tmp_dir"
        return 1
    fi

    info "Updating Zen Browser..."
    mkdir -p "$parent_dir" || {
        rm -rf "$tmp_dir"
        return 1
    }

    if ! replace_path "$tmp_dir/zen" "$install_dir"; then
        rm -rf "$tmp_dir"
        return 1
    fi

    rm -rf "$tmp_dir"
    "$install_dir/zen" --version >/dev/null 2>&1 || return 1
    log "Zen Browser updated."
}

update_opencode_managed() {
    if any_system_package_installed opencode; then
        info "Skipping OpenCode: system package manager handles it."
        return 0
    fi

    if ! cmd_is_managed opencode "$HOME/.opencode" "$HOME/.local/bin/opencode"; then
        info "Skipping OpenCode: binary is not managed by the upstream installer."
        return 0
    fi

    info "Updating OpenCode..."
    opencode upgrade || return 1
    log "OpenCode updated."
}

update_nerd_fonts() {
    local version font tmp_dir
    local fonts=(JetBrainsMono RobotoMono NerdFontsSymbolsOnly)

    if [ ! -d "$FONT_DIR" ]; then
        info "Skipping Nerd Fonts: $FONT_DIR does not exist."
        return 0
    fi

    version=$(github_latest_release_tag ryanoasis/nerd-fonts)
    [ -n "$version" ] || {
        error "Could not determine the latest Nerd Fonts release."
        return 1
    }

    info "Updating Nerd Fonts to ${version}..."

    for font in "${fonts[@]}"; do
        tmp_dir=$(mktemp -d)

        if ! download_file "https://github.com/ryanoasis/nerd-fonts/releases/download/${version}/${font}.zip" "$tmp_dir/${font}.zip"; then
            error "Failed to download Nerd Font archive for ${font}."
            rm -rf "$tmp_dir"
            return 1
        fi

        if ! sudo install -d -m 0755 "$FONT_DIR"; then
            error "Failed to create font directory at ${FONT_DIR}."
            rm -rf "$tmp_dir"
            return 1
        fi

        if ! sudo unzip -qo "$tmp_dir/${font}.zip" -d "$FONT_DIR" -x "LICENSE*" "README*"; then
            error "Failed to extract Nerd Font archive for ${font}."
            rm -rf "$tmp_dir"
            return 1
        fi

        rm -rf "$tmp_dir"
    done

    if command -v fc-cache >/dev/null 2>&1; then
        sudo fc-cache -f "$FONT_DIR" >/dev/null 2>&1 || return 1
    fi

    log "Nerd Fonts updated to ${version}."
}

update_font_awesome() {
    local version tmp_dir source_dir archive_dir

    version=$(github_latest_release_tag FortAwesome/Font-Awesome)
    [ -n "$version" ] || {
        error "Could not determine the latest Font Awesome release."
        return 1
    }

    info "Updating Font Awesome to ${version}..."
    tmp_dir=$(mktemp -d)
    archive_dir="$tmp_dir/extracted"
    source_dir="$archive_dir/fontawesome-free-${version}-desktop/otfs"

    if ! download_file "https://github.com/FortAwesome/Font-Awesome/releases/download/${version}/fontawesome-free-${version}-desktop.zip" "$tmp_dir/fontawesome.zip"; then
        error "Failed to download Font Awesome archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    mkdir -p "$archive_dir" || {
        rm -rf "$tmp_dir"
        return 1
    }

    if ! unzip -q "$tmp_dir/fontawesome.zip" -d "$archive_dir"; then
        error "Failed to extract Font Awesome archive."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! ls "$source_dir"/*.otf >/dev/null 2>&1; then
        error "Font Awesome archive did not contain the expected OTF files."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! sudo install -d -m 0755 "$FONT_AWESOME_DIR"; then
        error "Failed to create font directory at ${FONT_AWESOME_DIR}."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! sudo install -m 0644 "$source_dir"/*.otf "$FONT_AWESOME_DIR/"; then
        error "Failed to install Font Awesome OTF files."
        rm -rf "$tmp_dir"
        return 1
    fi

    rm -rf "$tmp_dir"

    if command -v fc-cache >/dev/null 2>&1; then
        sudo fc-cache -f "$FONT_ROOT" >/dev/null 2>&1 || return 1
    fi

    if command -v fc-list >/dev/null 2>&1 && ! fc-list | grep -qi "Font Awesome"; then
        error "Font Awesome was not found in the fontconfig database after install."
        return 1
    fi

    log "Font Awesome updated to ${version}."
}

print_update_summary() {
    echo ""

    if [ "$STEP_HAD_FAILURES" = true ]; then
        warn "Package update completed with partial success."
        warn "Failed steps: ${STEP_FAILED_LABELS[*]}"
        return 1
    fi

    log "Package update completed successfully."
    return 0
}

main() {
    info "Repo directory: $SCRIPT_REPO_DIR"

    if [ "$UPDATE_SYSTEM" = true ]; then
        [ "$DISTRO" = ubuntu ] && run_step "Ubuntu PPA refresh" add_ppas
        run_step "system package update" update_system_packages
    else
        info "Skipping distro-managed packages by request."
    fi

    if [ "$UPDATE_NON_SYSTEM" = true ]; then
        run_step "TPM update" update_tpm
        run_step "Rust toolchain update" update_rust_toolchain
        run_step "tree-sitter CLI update" update_tree_sitter_cli
        run_step "Neovim update" update_neovim_managed
        run_step "7-Zip update" update_7zip_managed
        run_step "fzf update" update_fzf
        run_step "Starship update" update_starship
        run_step "Zoxide update" update_zoxide
        run_step "Yazi update" update_yazi
        run_step "Lazygit update" update_lazygit
        run_step "GitHub CLI update" update_gh_managed
        run_step "Typst update" update_typst_managed
        run_step "Julia update" update_julia_managed
        run_step "Clipboard update" update_clipboard_managed
        run_step "sesh update" update_sesh_managed
        run_step "pipx tools update" update_python_tools_managed
        run_step "Kitty update" update_kitty_managed
        run_step "LocalSend update" update_localsend_managed
        run_step "Zen Browser update" update_zen_managed
        run_step "OpenCode update" update_opencode_managed
        [ "$UPDATE_FONTS" = true ] && run_step "Nerd Fonts update" update_nerd_fonts
        [ "$UPDATE_FONTS" = true ] && run_step "Font Awesome update" update_font_awesome
        run_step "Neovim plugin sync" sync_neovim_plugins
    else
        info "Skipping non-package-manager tools by request."
    fi

    print_update_summary
}

main "$@"
