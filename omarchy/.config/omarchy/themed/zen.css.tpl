:root {
  --omarchy-background: {{ background }} !important;
  --omarchy-dark-background: {{ dark_background }} !important;
  --omarchy-darker-background: {{ darker_background }} !important;
  --omarchy-lighter-background: {{ lighter_background }} !important;
  --omarchy-foreground: {{ foreground }} !important;
  --omarchy-bright-foreground: {{ bright_foreground }} !important;
  --omarchy-muted: {{ muted }} !important;
  --omarchy-accent: {{ accent }} !important;
  --omarchy-red: {{ red }} !important;
  --omarchy-orange: {{ orange }} !important;
  --omarchy-yellow: {{ yellow }} !important;
  --omarchy-green: {{ green }} !important;
  --omarchy-cyan: {{ cyan }} !important;
  --omarchy-blue: {{ blue }} !important;
  --omarchy-magenta: {{ magenta }} !important;
  --omarchy-selection: {{ selection }} !important;
}
